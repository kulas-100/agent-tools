  "components": {
    "schemas": {
      "CalculatorRequest": {
        "properties": {
          "expression": {
            "type": "string",
            "title": "Expression",
            "description": "Mathematical expression to evaluate (e.g. '2 + 2 * 10', 'sqrt(144)', 'sin(pi/2)')"
          }
        },
        "type": "object",
        "required": [
          "expression"
        ],
        "title": "CalculatorRequest"
      },
      "CalculatorResponse": {
        "properties": {
          "expression": {
            "type": "string",
            "title": "Expression"
          },
          "result": {
            "type": "number",
            "title": "Result"
          },
          "result_str": {
            "type": "string",
            "title": "Result Str"
          }
        },
        "type": "object",
        "required": [
          "expression",
          "result",
          "result_str"
        ],
        "title": "CalculatorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IPInfoResponse": {
        "properties": {
          "ip": {
            "type": "string",
            "title": "Ip"
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City"
          },
          "region": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region"
          },
          "country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country"
          },
          "country_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country Code"
          },
          "latitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latitude"
          },
          "longitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Longitude"
          },
          "timezone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timezone"
          },
          "isp": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Isp"
          }
        },
        "type": "object",
        "required": [
          "ip"
        ],
        "title": "IPInfoResponse"
      },
      "NewsArticle": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "published": {
            "type": "string",
            "title": "Published"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          }
        },
        "type": "object",
        "required": [
          "title",
          "source",
          "url",
          "published",
          "summary"
        ],
        "title": "NewsArticle"
      },
      "NewsRequest": {
        "properties": {
          "topic": {
            "type": "string",
            "title": "Topic",
            "description": "News topic or keyword (e.g. 'AI', 'climate change', 'bitcoin')"
          },
          "max_articles": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 20.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Articles",
            "description": "Number of articles to return (max 20)",
            "default": 5
          }
        },
        "type": "object",
        "required": [
          "topic"
        ],
        "title": "NewsRequest"
      },
      "NewsResponse": {
        "properties": {
          "topic": {
            "type": "string",
            "title": "Topic"
          },
          "articles": {
            "items": {
              "$ref": "#/components/schemas/NewsArticle"
            },
            "type": "array",
            "title": "Articles"
          }
        },
        "type": "object",
        "required": [
          "topic",
          "articles"
        ],
        "title": "NewsResponse"
      },
      "PDFExtractRequest": {
        "properties": {
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url",
            "description": "Direct URL of the PDF to download and extract"
          },
          "file_base64": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Base64",
            "description": "Base64-encoded PDF content"
          },
          "max_pages": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Pages",
            "description": "Maximum pages to extract to protect token limits",
            "default": 15
          },
          "start_page": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Page",
            "description": "Starting page number (1-indexed)",
            "default": 1
          }
        },
        "type": "object",
        "title": "PDFExtractRequest"
      },
      "PDFExtractResponse": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "author": {
            "type": "string",
            "title": "Author"
          },
          "total_pages": {
            "type": "integer",
            "title": "Total Pages"
          },
          "pages_extracted": {
            "type": "integer",
            "title": "Pages Extracted"
          },
          "word_count": {
            "type": "integer",
            "title": "Word Count"
