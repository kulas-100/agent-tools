              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/usage": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Get my usage stats",
        "description": "Returns current API key usage stats including daily and total call counts.",
        "operationId": "get_my_usage_usage_get",
        "parameters": [
          {
            "name": "X-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Your AgentTools API key",
              "title": "X-Api-Key"
            },
            "description": "Your AgentTools API key"
          },
          {
            "name": "X-RapidAPI-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "description": "RapidAPI key (if using RapidAPI marketplace)",
              "title": "X-Rapidapi-Key"
            },
            "description": "RapidAPI key (if using RapidAPI marketplace)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/tools/pdf-extract": {
      "post": {
        "tags": [
          "Tools"
        ],
        "summary": "Extract text and metadata from PDF",
        "description": "Downloads or decodes a PDF document and extracts structured text per page, document metadata (title, author), total page count, document outlines, and estimated LLM token count. Designed specifically for AI agent document ingestion.",
        "operationId": "pdf_extract_endpoint_tools_pdf_extract_post",
        "parameters": [
          {
            "name": "X-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Your AgentTools API key",
              "title": "X-Api-Key"
            },
            "description": "Your AgentTools API key"
          },
          {
            "name": "X-RapidAPI-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "description": "RapidAPI key (if using RapidAPI marketplace)",
              "title": "X-Rapidapi-Key"
            },
            "description": "RapidAPI key (if using RapidAPI marketplace)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PDFExtractRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PDFExtractResponse"
                }
              }
            }
          },
          "422": {
