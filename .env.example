# Copy this file to .env and fill in values
# cp .env.example .env

# Default API key for testing (auto-created in DB on first run)
DEFAULT_API_KEY=test-api-key-12345

# Master admin API key
MASTER_API_KEY=change-me-to-a-secure-key

# SQLite database path
DB_PATH=agent_api.db

# Server settings (used by Dockerfile / Railway / Render)
PORT=8000
